# WhatsApp Contact Number (include country code without + or spaces, e.g. 919876543210 or 15551234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# Google Site Verification Code
NEXT_PUBLIC_GOOGLE_VERIFICATION=YOUR_GOOGLE_VERIFICATION_CODE

# Cal.com booking event link (format: username or username/event-slug)
# Find this in your Cal.com dashboard → Event Types → Share
NEXT_PUBLIC_CAL_LINK=deeptech

# Cal.com webhook HMAC secret (set this in Cal.com dashboard → Webhooks → Secret)
# When set, the /api/webhooks/calcom endpoint will verify all incoming signatures.
CAL_WEBHOOK_SECRET=your_cal_webhook_secret_here
